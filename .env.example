# --- MCP server (mcp/server.py) ---
REPOS_ROOT=/srv/repos
MCP_HOST=0.0.0.0
MCP_PORT=5000
MCP_PATH=/mcp
MCP_AUTH_TOKEN=replace-with-a-long-random-token
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=glpat-...          # read_repository scope; used for auto-clone

# --- Review scripts (scripts/review.py, scripts/post-review.py) ---
# Set the same MCP_AUTH_TOKEN value here as on the server.
ANTHROPIC_API_KEY=sk-ant-...
MCP_SERVER_URL=https://mcp.example.com/mcp
GITLAB_TOKEN=glpat-...            # token with `api` scope, posts MR comments
# REVIEW_MODEL=claude-opus-4-8
